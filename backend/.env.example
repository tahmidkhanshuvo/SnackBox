APP_NAME=SnackBox
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
LOG_CHANNEL=stack
LOG_LEVEL=info

# For a simple local setup. Create this SQLite file before migrating.
DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/database.sqlite
# Hosted MySQL/PostgreSQL may use DATABASE_URL or DB_URL instead.
DATABASE_URL=
DB_URL=
DB_SSLMODE=require

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public

FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173

# Explicit first-admin setup command; never seeded on server startup.
ADMIN_EMAIL=
ADMIN_PASSWORD=
